# Secrets — must never enter the image
.env
.env*.local

# Version control
.git
.gitignore

# Python caches / virtual envs
__pycache__/
*.py[cod]
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# ADK local session state
**/.adk/
*.db

# Tests, docs and dev-only files (not needed at runtime). The image root is
# also the default SENTINEL_SCAN_ROOT, so anything left here is scannable.
tests/
README.md
docs/
tasks/
requirements-dev.txt
*.png

# Agent/tooling state — never ship
.claude/
.agents/
.codex/
graphify-out/
**/graphify-out/

# Dashboard build artifacts (built inside Docker, not from host)
sentinel/dashboard/node_modules/
sentinel/dashboard/dist/

# Local scratch
*.sarif.json
*.log
