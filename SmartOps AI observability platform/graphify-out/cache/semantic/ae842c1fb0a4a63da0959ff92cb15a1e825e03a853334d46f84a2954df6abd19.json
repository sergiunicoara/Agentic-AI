{"nodes": [{"id": "docs_adr_002_mastra_hitl_workflow", "label": "ADR-002: Mastra AI for Human-in-the-Loop Workflow", "file_type": "document", "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_alert_to_ticket", "label": "alertToTicket workflow (detect \u2192 RCA \u2192 approve \u2192 ticket)", "file_type": "concept", "rationale": "Four-step Mastra workflow chaining the agents with a suspend/resume gate before ticket creation. POST /ai/workflows/alert-to-ticket starts the run, it suspends at await-approval returning { runId, status: 'suspended', rca } and writes an incident row with status pending_approval; POST /ai/workflows/:runId/resume { approved } resumes the create-ticket step and updates the row to ticketed or rejected.", "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_mastra_workflow", "label": "Mastra AI workflow engine (createWorkflow, suspend/resume, ^1.50.1)", "file_type": "concept", "rationale": "Chosen because native suspend/resume \u2014 a workflow that pauses mid-execution and resumes from a different HTTP request \u2014 is the core execution primitive, not a bolt-on; that single capability determines the whole HITL architecture. Also TypeScript-native with Zod-validated inputData/resumeData, composable independent Agent instances, and direct @ai-sdk/anthropic integration. Alternatives rejected: a custom Redis queue + polling (bespoke state-persistence code and extra infra), Temporal (production-grade durable execution but requires operating a server cluster), and LangGraph/LangChain (Python-first, adds a language boundary; suspend-resume is not a first-class primitive). Accepted risks: Mastra's API surface changed significantly between 0.x and 1.x so the version is pinned, and it runs in-process with Fastify.", "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concept_alert_to_ticket", "target": "concept_mastra_workflow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "concept_alert_to_ticket", "target": "concept_hitl", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "concept_mastra_workflow", "target": "concept_hitl", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "concept_mastra_workflow", "target": "concept_ai_agents", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "concept_mastra_workflow", "target": "concept_fastify_api", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_002_mastra_hitl_workflow", "target": "concept_mastra_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_002_mastra_hitl_workflow", "target": "concept_hitl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/002-mastra-hitl-workflow.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_002_mastra_hitl_workflow",