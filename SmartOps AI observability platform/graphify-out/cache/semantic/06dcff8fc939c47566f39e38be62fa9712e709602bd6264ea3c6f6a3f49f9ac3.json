{"nodes": [{"id": "docs_runbooks_scaling", "label": "Runbook: Scaling SmartOps", "file_type": "document", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_horizontal_scaling", "label": "Horizontal scaling strategy (stateless API + web)", "file_type": "concept", "rationale": "Both API and web are stateless so they scale by replicaCount or HPA as-is. The one caveat is SSE: long-lived connections must reach the same API instance, so nginx ingress cookie session affinity (smartops-api, 3600s) is required. Storage sizing rule of thumb for VM: storage_GB = (metrics_per_second \u00d7 86400 \u00d7 retention_days) / (10 \u00d7 1e9), i.e. ~7.8GB for 10k samples/s over 90 days.", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_workflow_state_store", "label": "PostgresStore workflow state (@mastra/pg)", "file_type": "concept", "rationale": "Mastra checkpoints live in the shared application PostgreSQL database rather than LibSQL or an in-memory store, so a suspended run survives an API restart and can be resumed by any API replica \u2014 not only the instance that started it. Removes the need for a custom job queue.", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_elasticsearch_ilm", "label": "Elasticsearch ILM hot\u2192warm\u2192cold\u2192delete tiers", "file_type": "concept", "rationale": "Pre-configured in infra/elasticsearch/index-templates/; max_age values are the retention tuning knob.", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_pgbouncer", "label": "PgBouncer connection pooling (write-heavy path)", "file_type": "concept", "rationale": "Recommended for high audit-log write volume; requires ?pgbouncer=true in DATABASE_URL to disable Drizzle prepared statements.", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_self_monitoring", "label": "SmartOps self-monitoring (docker_stats \u2192 kubeletstats)", "file_type": "concept", "rationale": "The OTel Collector's docker_stats receiver scrapes SmartOps's own container metrics locally; in Kubernetes it is replaced by the kubeletstats receiver (30s interval, serviceAccount auth) so the Grafana 'Asset & Audit' dashboard surfaces the platform's own resource usage.", "source_file": "docs/runbooks/scaling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concept_mastra_workflow", "target": "concept_workflow_state_store", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/scaling.md", "source_location": null, "weight": 1.0}, {"source": "concept_workflow_state_store", "target": "concept_postgresql", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/scaling.md", "source_location": null, "weight": 1.0}, {"source": "concept_sse", "target": "concept_horizontal_scaling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/scaling.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_scaling", "target": "concept_horizontal_scaling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/scaling.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_scaling", "target": "concept_helm_chart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou