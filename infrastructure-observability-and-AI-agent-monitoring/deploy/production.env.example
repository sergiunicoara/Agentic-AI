ENVIRONMENT=production
PUBLIC_DOMAIN=observability.example.com
AGENT_INGEST_DOMAIN=agents.observability.example.com
ACME_EMAIL=ops@example.com

DATABASE_URL=postgresql+asyncpg://obs:replace-me@postgres:5432/observability
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-output-from-scripts/generate_secrets.py
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-rotated-client-secret
OIDC_REDIRECT_URI=https://observability.example.com/auth/callback
FRONTEND_ORIGIN=https://observability.example.com
# Caddy -> nginx -> Envoy -> backend. Recount if the edge topology changes.
TRUSTED_PROXY_HOPS=3
EMIT_AGENT_KEYS={"example-agent":"replace-with-32-plus-character-key"}
OTEL_UPSTREAM_ENDPOINT=otel-collector.example.com:4317
