# ── Postgres ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://obs:obs@postgres:5432/observability

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── gRPC server port (internal) ──────────────────────────────────────────────
GRPC_PORT=50051

# ── FastAPI REST port (internal) ─────────────────────────────────────────────
REST_PORT=8000

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a random secret before deploying
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agent-observability-backend

# ── OIDC ─────────────────────────────────────────────────────────────────────
# Google: keep issuer as https://accounts.google.com
# Keycloak local: http://host.docker.internal:8081/realms/<your-realm>
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-your-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# ── gRPC emit auth ───────────────────────────────────────────────────────────
# SDK agents must send this as x-api-key gRPC metadata. Change in production.
EMIT_API_KEY=replace-with-a-random-ingestion-key
# Optional production mapping, e.g. {"agent-a":"key-a","agent-b":"key-b"}
EMIT_AGENT_KEYS=

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend (used by Vite at build time) ────────────────────────────────────
VITE_ENVOY_URL=
